# Copia este archivo como .env y rellena los valores. Nunca subas el .env a git.

# En Railway: ${{Postgres.DATABASE_URL}} (conexión interna)
DATABASE_URL="postgresql://usuario:contraseña@host:5432/base"

# Genera con: openssl rand -base64 32
JWT_SECRET=""

# Correos con acceso de administración, separados por comas
ADMIN_EMAILS=""

# Groq: análisis de fotos de comida en la app del paciente
GROQ_API_KEY=""

# Opcionales (estos son los valores por defecto)
# TRIAL_DAYS=14
# DEFAULT_PLAN_CODE="BASICO"
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_DAYS=30
# GROQ_VISION_MODEL="qwen/qwen3.8-27b"
# FOOD_SCAN_DAILY_LIMIT=25
# PATIENT_INVITE_DAYS=14
