{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "{dist/**,node_modules/pdfkit/js/data/**}"
    }
  },
  "rewrites": [{ "source": "/((?!index\\.html$).*)", "destination": "/api" }]
}
