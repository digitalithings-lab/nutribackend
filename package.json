{
  "name": "nutripro-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend de NutriPro",
  "main": "dist/main.js",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "prisma migrate deploy && node dist/seed.js && node dist/main.js",
    "dev": "npm run build && node --env-file=.env dist/main.js",
    "db:validate": "prisma validate",
    "vercel-build": "prisma generate && prisma migrate deploy && tsc -p tsconfig.json && node dist/seed.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.8",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/client": "6.16.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "pdfkit": "^0.17.2",
    "prisma": "6.16.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/pdfkit": "^0.17.3",
    "typescript": "^5.9.3"
  }
}
